# Compiler flags, sanitizers, and coverage shared by every OfxGrip target.

add_library(ofxgrip_options INTERFACE)
add_library(OfxGrip::options ALIAS ofxgrip_options)

if(MSVC)
  target_compile_options(ofxgrip_options INTERFACE /W4 /permissive- /Zc:__cplusplus /utf-8 /EHsc)
  target_compile_definitions(ofxgrip_options INTERFACE _CRT_SECURE_NO_WARNINGS NOMINMAX WIN32_LEAN_AND_MEAN)
  if(OFXGRIP_WARNINGS_AS_ERRORS)
    target_compile_options(ofxgrip_options INTERFACE /WX)
  endif()
else()
  target_compile_options(ofxgrip_options INTERFACE -Wall -Wextra -Wpedantic -Wshadow -Wconversion -Wsign-conversion -Wnon-virtual-dtor)
  if(OFXGRIP_WARNINGS_AS_ERRORS)
    target_compile_options(ofxgrip_options INTERFACE -Werror)
  endif()
endif()

if(OFXGRIP_SANITIZER)
  if(MSVC)
    message(WARNING "OFXGRIP_SANITIZER is ignored on MSVC in this phase")
  else()
    string(REPLACE ";" "," _ofxgrip_sanitizers "${OFXGRIP_SANITIZER}")
    target_compile_options(ofxgrip_options INTERFACE -fsanitize=${_ofxgrip_sanitizers} -fno-omit-frame-pointer -g)
    target_link_options(ofxgrip_options INTERFACE -fsanitize=${_ofxgrip_sanitizers})
  endif()
endif()

if(OFXGRIP_COVERAGE)
  if(CMAKE_CXX_COMPILER_ID MATCHES "Clang")
    target_compile_options(ofxgrip_options INTERFACE -fprofile-instr-generate -fcoverage-mapping -O0 -g)
    target_link_options(ofxgrip_options INTERFACE -fprofile-instr-generate)
  elseif(CMAKE_CXX_COMPILER_ID STREQUAL "GNU")
    target_compile_options(ofxgrip_options INTERFACE --coverage -O0 -g)
    target_link_options(ofxgrip_options INTERFACE --coverage)
  else()
    message(WARNING "OFXGRIP_COVERAGE needs clang or gcc")
  endif()
endif()
